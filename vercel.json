{
  "redirects": [
    { "source": "/products", "destination": "/", "permanent": true },
    { "source": "/products/", "destination": "/", "permanent": true },
    { "source": "/tool/:slug*", "destination": "/tools/:slug*", "permanent": true },

    { "source": "/product/:slug*/feed/", "destination": "/", "permanent": true },
    { "source": "/product/:slug*/feed", "destination": "/", "permanent": true },
    { "source": "/product/:slug*", "destination": "/", "permanent": true },
    { "source": "/product-category/:slug*/feed/", "destination": "/", "permanent": true },
    { "source": "/product-category/:slug*/feed", "destination": "/", "permanent": true },
    { "source": "/product-category/:slug*", "destination": "/", "permanent": true },
    { "source": "/product-tag/:slug*/feed/", "destination": "/", "permanent": true },
    { "source": "/product-tag/:slug*/feed", "destination": "/", "permanent": true },
    { "source": "/product-tag/:slug*", "destination": "/", "permanent": true },
    { "source": "/shop-2/:path*", "destination": "/", "permanent": true },
    { "source": "/checkout/", "destination": "/", "permanent": true },
    { "source": "/checkout", "destination": "/", "permanent": true },
    { "source": "/brand/:slug*", "destination": "/", "permanent": true },
    { "source": "/wp-login.php", "destination": "/", "permanent": true },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacy", "permanent": true },

    { "source": "/blog/how-to-save-income-tax-india-2026", "destination": "/blog/how-to-save-income-tax-india-2026-27", "permanent": true },
    { "source": "/blog/how-to-calculate-emi-home-loan", "destination": "/blog/how-to-calculate-emi-home-loan-india", "permanent": true },
    { "source": "/blog/sip-vs-fd-2026", "destination": "/blog/sip-vs-fd-which-investment-better", "permanent": true },
    { "source": "/blog/gst-for-small-business-india", "destination": "/blog/gst-guide-small-business-india", "permanent": true },
    { "source": "/blog/nps-ppf-elss-comparison-2026", "destination": "/blog/nps-vs-ppf-vs-elss-best-tax-saving-2026", "permanent": true },

    { "source": "/:path*", "has": [{ "type": "host", "value": "sabtools.vercel.app" }], "destination": "https://sabtools.in/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "sabtools-two.vercel.app" }], "destination": "https://sabtools.in/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/tools/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://adservice.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://pagead2.googlesyndication.com; frame-src https://pagead2.googlesyndication.com https://www.google.com; object-src 'none'; base-uri 'self'" }
      ]
    }
  ]
}
