# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in the values.
# NEVER commit the real .env file (it is in .gitignore).
# ─────────────────────────────────────────────────────────────

# ─── Claude API (content generation) ─────────────────────────
ANTHROPIC_API_KEY=
# Model: claude-opus-4-7 = best quality. Switch to claude-sonnet-4-6 for lower cost.
CLAUDE_MODEL=claude-opus-4-7

# ─── Blogger API (draft publishing) ──────────────────────────
# BLOG_ID: find it in Blogger -> Settings, or in the dashboard URL.
BLOG_ID=
# These three come from scripts/get_blogger_token.py (run once).
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# ─── Email notification (Gmail SMTP recommended) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail use an "App Password", NOT your normal password.
SMTP_PASSWORD=
NOTIFY_TO=

# ─── Safety guard ────────────────────────────────────────────
# If this many drafts are already waiting for review, skip generating a new one.
MAX_PENDING_DRAFTS=5
